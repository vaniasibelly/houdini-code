name: privileged_ports
dockerfile:
  - path: Dockerfile
dependencies:
  - server: False
docker_config:
  - network_mode: bridge
  - read_only: False
  - security_opt: ["no-new-privileges"]
  - pid_mode: null
  - cpu_shares: 512
  - volumes: null
  - mem_limit: null
  - cpuset_cpus: null
  - cpu_quota: null
  - cpu_period: null
  - cap_add: []
  - cap_drop: ["NET_BIND_SERVICE"]
  - privileged: False
  - user: huzi
  - pids_limit: null
  - ipc_mode: null
  - userns_mode: null
trick:
  - path: /houdini/tricks/PrivilegedPorts
